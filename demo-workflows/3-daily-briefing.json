        "additionalFields": {
          "maxRsi": 30,
          "minMarketCapB": 2,
          "sortBy": "rsi",
          "sortDir": "asc"
        }
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Oversold, >$2B",
