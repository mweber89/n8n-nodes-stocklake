{
  "name": "n8n-nodes-stocklake",
  "version": "0.1.1",
  "description": "n8n community node for the Stocklake API — real-time and historical US/international stock market data, technical indicators, AI-synthesized research, insider/institutional activity, earnings intelligence, and macro/sector outlook.",
  "keywords": [
    "n8n-community-node-package",
    "stocklake",
    "stock market",
    "stock market data",
    "finance",
    "trading",
    "stock screener",
    "technical indicators",
    "market data api"
  ],
  "license": "MIT",
  "homepage": "https://stocklake.dev",
  "author": {
    "name": "Stocklake",
    "email": "api@stocklake.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mweber89/n8n-nodes-stocklake.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/StocklakeApi.credentials.js",
      "dist/credentials/StocklakeOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Stocklake/Stocklake.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.30.0",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.35.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
