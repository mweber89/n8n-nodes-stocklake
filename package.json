{
  "name": "n8n-nodes-stocklake",
  "version": "2.0.0",
  "description": "n8n community nodes for Stocklake: stock market data with quotes delayed about 15 minutes, technical indicators, fundamentals, insider activity, SEC filings, earnings, AI-synthesized research, macro and sector outlook, and a trigger that starts a workflow on signals, earnings, filings, insider purchases, RSI crossings and price moves.",
  "keywords": [
    "n8n-community-node-package",
    "stocklake",
    "stock market",
    "stock market data",
    "finance",
    "trading",
    "stock screener",
    "technical indicators",
    "market data api",
    "trigger"
  ],
  "license": "MIT",
  "homepage": "https://stocklake.dev",
  "author": {
    "name": "Stocklake",
    "email": "api@stocklake.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mweber89/n8n-nodes-stocklake.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/StocklakeApi.credentials.js",
      "dist/credentials/StocklakeOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Stocklake/Stocklake.node.js",
      "dist/nodes/StocklakeTrigger/StocklakeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.30.0",
    "@types/node": "^20.19.43",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.35.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
